# Required: get your API key from Curseforge's console at https://console.curseforge.com/
# WARNING: Any '$' characters in the CF_API_KEY may cause auth errors. 
# Surrounding the key in single quotes (') avoids this. KEEP THEM! It may work without, but just as well it might not.
CF_API_KEY='curseforge_api_key_goes_here'

# Required: get your Playit agent's secret key after setting up an agent and tunnel on their website at https://playit.gg/account/setup
SECRET_KEY=secret_key_goes_here

# Required: Can be anything really. Still I recommend a strong long random hex string.
RCON_PASSWORD=minecraft_rcon_password_goes_here

# Required: The following two directories need to be created beforehand and set up here OR ELSE
# logging and backups will be broken and result in unexpected behavior without edits to docker-compose.yml
# USE ABSOLUTE PATHS
LOG_PATH=/path/to/log/directory/goes/here/
BACKUP_PATH=/path/to/server/backups/directory/goes/here/

# Optional: Your timezone in TZ database format e.g. Europe/Tallinn (see "TZ identifier" column here: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones )
# My own timezone is pre-filled below, uncomment the line (remove the '# ' before it) to set it.
# TIMEZONE=Europe/Tallinn
